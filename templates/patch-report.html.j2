<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Patch Report - {{ report_host }}</title>

    <style>
        :root {
            --page-background: #f3f4f6;
            --card-background: #ffffff;
            --header-background: #111827;
            --header-secondary: #1f2937;
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --success: #15803d;
            --warning: #b45309;
            --danger: #b91c1c;
            --text: #1f2937;
            --muted: #6b7280;
            --border: #d1d5db;
            --report-background: #111827;
            --report-text: #e5e7eb;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--page-background);
            color: var(--text);
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Helvetica,
                Arial,
                sans-serif;
        }

        .header {
            background:
                linear-gradient(
                    135deg,
                    var(--header-background),
                    var(--header-secondary)
                );
            color: white;
            padding: 28px 24px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
        }

        .header-content {
            width: min(1400px, 94%);
            margin: 0 auto;
        }

        .header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 700;
        }

        .header .subtitle {
            margin-top: 7px;
            color: #d1d5db;
            font-size: 15px;
        }

        .container {
            width: min(1400px, 94%);
            margin: 28px auto 40px;
        }

        .navigation {
            margin-bottom: 20px;
        }

        .back-button {
            display: inline-block;
            padding: 10px 16px;
            background: var(--primary);
            color: white;
            text-decoration: none;
            border-radius: 7px;
            font-weight: 600;
            transition:
                background-color 0.15s ease,
                transform 0.15s ease;
        }

        .back-button:hover {
            background: var(--primary-hover);
            transform: translateY(-1px);
        }

        .summary {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 22px;
        }

        .summary-card {
            background: var(--card-background);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 18px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.06);
        }

        .summary-card .label {
            margin-bottom: 7px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .summary-card .value {
            font-size: 20px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .status-success {
            color: var(--success);
        }

        .status-warning {
            color: var(--warning);
        }

        .status-danger {
            color: var(--danger);
        }

        .report-card {
            overflow: hidden;
            background: var(--card-background);
            border: 1px solid var(--border);
            border-radius: 10px;
            box-shadow: 0 2px 7px rgba(0, 0, 0, 0.08);
        }

        .report-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 16px 20px;
            background: white;
            border-bottom: 1px solid var(--border);
        }

        .report-card-header h2 {
            margin: 0;
            font-size: 19px;
        }

        .report-card-header .format {
            color: var(--muted);
            font-size: 13px;
        }

        .report-content {
            margin: 0;
            padding: 22px;
            overflow-x: auto;
            background: var(--report-background);
            color: var(--report-text);
            font-family:
                "Cascadia Code",
                "SFMono-Regular",
                Consolas,
                "Liberation Mono",
                Menlo,
                monospace;
            font-size: 14px;
            line-height: 1.55;
            white-space: pre;
            tab-size: 4;
        }

        .footer {
            padding: 22px 0 0;
            color: var(--muted);
            font-size: 13px;
            text-align: center;
        }

        @media (max-width: 700px) {
            .header {
                padding: 22px 14px;
            }

            .header h1 {
                font-size: 24px;
            }

            .container {
                width: 96%;
                margin-top: 18px;
            }

            .report-content {
                padding: 15px;
                font-size: 12px;
            }

            .report-card-header {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

<header class="header">
    <div class="header-content">
        <h1>Patch Report: {{ report_host }}</h1>

        <div class="subtitle">
            Home Server Patch Management
        </div>
    </div>
</header>

<main class="container">

    <nav class="navigation">
        <a class="back-button" href="../index.html">
            &larr; Back to Patch Dashboard
        </a>
    </nav>

    <section class="summary">

        <div class="summary-card">
            <div class="label">Server</div>
            <div class="value">{{ report_host }}</div>
        </div>

        <div class="summary-card">
            <div class="label">Patch Run</div>
            <div class="value">{{ patch_run_id }}</div>
        </div>

        <div class="summary-card">
            <div class="label">Report Status</div>
            <div class="value status-success">Available</div>
        </div>

        <div class="summary-card">
            <div class="label">Controller</div>
            <div class="value">Saturn</div>
        </div>

    </section>

    <section class="report-card">

        <div class="report-card-header">
            <h2>Package and Reboot Details</h2>
            <div class="format">Generated by Ansible</div>
        </div>

        <pre class="report-content">{{ report_content | e }}</pre>

    </section>

    <footer class="footer">
        Home Server Patch Dashboard
    </footer>

</main>

</body>
</html>
